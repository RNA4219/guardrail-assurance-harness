{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAH component assessment request v1",
  "description": "部品診断専用。JSON整数表記、重複key/metric_id、分数の整合、fnrのbaseline禁止はruntimeの追加制約。通常CIの合格用入力ではない。",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "purpose": {
      "const": "component_validation"
    },
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assessed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "metric_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
          },
          "name": {
            "enum": [
              "recall",
              "fnr",
              "fpr",
              "asr",
              "mutation_score"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "numerator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "denominator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "baseline": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "metric_id",
          "name",
          "critical",
          "numerator",
          "denominator",
          "baseline"
        ],
        "additionalProperties": false
      }
    },
    "required_missing": {
      "type": "boolean"
    },
    "critical_missing": {
      "type": "boolean"
    },
    "integrity_failure": {
      "type": "boolean"
    },
    "forbidden_violation": {
      "type": "boolean"
    },
    "critical_violation": {
      "type": "boolean"
    },
    "warning": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "target_digest",
    "contract_digest",
    "purpose",
    "observed_at",
    "assessed_at",
    "metrics",
    "required_missing",
    "critical_missing",
    "integrity_failure",
    "forbidden_violation",
    "critical_violation",
    "warning"
  ],
  "additionalProperties": false
}
